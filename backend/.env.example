# Rumbo API — copy to backend/.env. Everything is optional: without keys the API runs in mock mode.

# Demo clock. Empty = real date (the demo data is relative to today, so any day works).
# Set a YYYY-MM-DD date only to pin a specific day.
DEMO_TODAY=

# Claude API for POST /api/trips/parse ("Pega tu reserva"). Empty = local mock extractor.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ElevenLabs agent for GET /api/voice/signed-url. Both empty = endpoint returns 404 (frontend uses mock voice).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Annual rate of the MOCK MyInvestor savings account. Demo value, not a real offer.
MOCK_SAVINGS_RATE=0.025

# Allowed frontend origins (comma-separated), or * for any origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Public URL of this API, used for absolute links (dossier PDFs).
PUBLIC_BASE_URL=http://localhost:8000

# Where runtime state and generated PDFs are written (default: data/runtime).
# RUNTIME_DIR=
