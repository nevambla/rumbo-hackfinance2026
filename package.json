{
  "name": "rumbo",
  "version": "0.1.0",
  "private": true,
  "description": "Rumbo — copiloto fiscal por voz para nómadas digitales (hackathon 2026)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"node --watch server/index.js\" \"vite\"",
    "server": "node server/index.js",
    "build": "vite build",
    "start": "npm run build && node server/index.js",
    "test": "node --test server/engine.test.js"
  },
  "dependencies": {
    "@elevenlabs/react": "^1.21.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "vite": "^8.3.6"
  }
}
